# Copy to .env.local and adjust. All values are optional.

# Where the API lives, as seen by the browser. Leave empty (recommended) when the
# frontend and the API share one origin: the Vite dev server proxies /api, /media
# and /ws, and in production a reverse proxy should do the same.
# VITE_API_BASE_URL=https://api.example.com

# Development only: where the Vite proxy forwards API traffic.
# VITE_DEV_API_TARGET=http://127.0.0.1:8000
