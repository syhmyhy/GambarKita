# Copy to deploy/.env and fill in. Never commit or share deploy/.env.

# The name Caddy gets an HTTPS certificate for (your router's DDNS name).
SITE_ADDRESS=rumahoren.asuscomm.com

# What guests open; QR codes point here.
PUBLIC_URL=https://rumahoren.asuscomm.com

# REQUIRED. Only people who know this key can create events. Keep it secret.
# 12+ characters, letters/digits/dashes only (a "$" would be cut off). Make one with:
#   openssl rand -hex 24
GK_EVENT_CREATION_KEY=

# Ports on the server. Keep 80/443 for the real site (Let's Encrypt needs them).
HTTP_PORT=80
HTTPS_PORT=443

# Upload limits, sized for a home laptop server. Change the numbers as you like.

# How many photos each guest can share per event (0 = no limit).
# Counted per phone browser, so it stops someone dumping a whole camera roll
# (a different browser starts a new allowance: it is not a hard quota).
# Turn it on before the event: only photos shared after that count.
GK_MAX_PHOTOS_PER_GUEST=7

# Photos per event (caps disk use).
GK_MAX_PHOTOS_PER_EVENT=2800

# Longest edge of each stored photo, in pixels. 0 keeps every photo's full
# resolution (still re-saved at high quality to remove location data): about
# 3-4 MB per photo, never more than 10 MB. A number such as 3072 saves disk and
# your home upload speed when the wall and guests load photos.
GK_MAX_STORED_DIMENSION=0

# Refuse uploads when less than this much disk is free (2 GB), so the laptop never fills up.
GK_MIN_FREE_DISK_BYTES=2147483648

# Easier on a small or old server's CPU and RAM. With 4 GB+ RAM to spare you can
# delete these two lines (defaults: 4 and 100000000).
GK_IMAGE_PROCESSING_CONCURRENCY=2
GK_IMAGE_PROCESSING_PIXEL_BUDGET=60000000
