# Copy to backend/.env and adjust. Every variable is optional; defaults are shown.

# --- General -----------------------------------------------------------------
GK_ENVIRONMENT=development          # development | production | test
GK_LOG_LEVEL=INFO
# GK_ENABLE_DOCS=true               # default: on except in production (/api/docs)

# Base URL of the React frontend; used for the links encoded in QR codes.
GK_PUBLIC_APP_URL=http://localhost:5173

# --- Server (python run.py) -------------------------------------------------------
GK_HOST=127.0.0.1                   # use 0.0.0.0 to let phones on your LAN connect
GK_PORT=8000
GK_RELOAD=false
# Behind a reverse proxy: comma-separated proxy IPs/CIDRs trusted for X-Forwarded-For.
# Never use '*': the client-controlled left-most entry would be trusted (spoofable IPs).
# GK_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Security ---------------------------------------------------------------------
GK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Testing the production build with `npm run preview`? Also add http://localhost:4173
GK_TRUSTED_HOSTS=*                  # e.g. api.example.com in production
GK_HSTS_ENABLED=false               # enable only when served over HTTPS
# Require an X-Event-Creation-Key header to create events (recommended in production).
# At least 12 characters; leave empty to allow anyone to create events.
# GK_EVENT_CREATION_KEY=change-me-to-a-long-random-string

# --- Storage & uploads ----------------------------------------------------------
GK_STORAGE_DIR=storage              # relative paths resolve against backend/
GK_MAX_UPLOAD_BYTES=10485760        # 10 MiB per photo (request body)
GK_MAX_STORED_BYTES=10485760        # cap on the re-encoded copy (lossy fallback, then 422)
GK_MAX_IMAGE_PIXELS=50000000        # decompression-bomb guard for JPEG (~50 MP)
GK_MAX_LOSSLESS_IMAGE_PIXELS=24000000  # PNG/WebP always decode at full size: lower cap
GK_MAX_IMAGE_DIMENSION=16383
GK_MAX_STORED_DIMENSION=4096        # longest edge of the stored copy; 0 keeps original size
GK_THUMBNAIL_SIZE=640
GK_MAX_PHOTOS_PER_EVENT=2000
GK_MAX_PHOTOS_PER_GUEST=0           # per guest per event; 0 = no limit (a guest = a browser's random X-Guest-Key; stored only while on)
GK_MIN_FREE_DISK_BYTES=536870912    # refuse uploads below 512 MiB free
GK_IMAGE_PROCESSING_PIXEL_BUDGET=100000000  # pixels decoded at once (bounds RAM, ~1-1.5 GB peak)
GK_IMAGE_PROCESSING_CONCURRENCY=4           # simultaneous decode jobs (bounds CPU)
GK_IMAGE_PROCESSING_QUEUE_TIMEOUT=20        # seconds before 503 SERVICE_BUSY
GK_LIBMAGIC=auto                    # auto | on | off (auto never loads libmagic on Windows)

# --- Rate limits ("N/second|minute|hour|day", ";" for several) ------------------------
# Per client IP (IPv6 grouped by /64) and per endpoint, across all events.
# Guests on venue Wi-Fi or carrier NAT usually share ONE public IP: size for the crowd.
GK_RATE_LIMIT_ENABLED=true
GK_RATE_LIMIT_CREATE_EVENT=20/hour
GK_RATE_LIMIT_UPLOAD=300/minute
GK_RATE_LIMIT_READ=1200/minute
GK_RATE_LIMIT_MANAGE=120/minute

# --- WebSockets ---------------------------------------------------------------------
GK_WS_CONNECT_RATE=300/minute
GK_WS_MESSAGE_RATE=30/minute
GK_WS_MAX_CONNECTIONS_PER_IP=500
GK_WS_MAX_CONNECTIONS_PER_EVENT=2000
GK_WS_RESERVED_HOST_CONNECTIONS=20  # extra per-event slots for host-authenticated wall displays
GK_WS_MAX_CONNECTIONS_TOTAL=10000
GK_WS_MAX_MESSAGE_BYTES=1024
GK_WS_SEND_QUEUE_SIZE=64
GK_WS_SEND_TIMEOUT=10
GK_WS_ALLOW_MISSING_ORIGIN=true
